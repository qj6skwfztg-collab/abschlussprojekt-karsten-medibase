rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser()
        && request.auth.uid == 'IjelVzBlIIgkJWgLiDdHrhLtwDf1';
    }

    function validPersonalMedication() {
      return request.resource.data.keys().hasAll([
          'name',
          'dosage',
          'intakeTime',
          'intakeTimes',
          'notes',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'dosage',
          'intakeTime',
          'intakeTimes',
          'notes',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.dosage is string
        && request.resource.data.dosage.size() >= 1
        && request.resource.data.dosage.size() <= 100
        && request.resource.data.intakeTime is string
        && request.resource.data.intakeTime.size() >= 4
        && request.resource.data.intakeTime.size() <= 20
        && request.resource.data.intakeTimes is list
        && request.resource.data.intakeTimes.size() >= 1
        && request.resource.data.intakeTimes.size() <= 8
        && request.resource.data.intakeTimes[0] is string
        && request.resource.data.intakeTimes.toSet().size()
          == request.resource.data.intakeTimes.size()
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.createdAt is timestamp;
    }

    function validEmergencyContact() {
      return request.resource.data.keys().hasAll([
          'name',
          'phone',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt is timestamp;
    }

    match /medications/{medicationId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name',
          'category',
          'description',
          'source',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 1000
        && request.resource.data.source is string
        && request.resource.data.source.size() >= 5
        && request.resource.data.source.size() <= 500;

      allow update, delete: if false;
    }

    match /users/{userId}/medications/{personalMedicationId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && validPersonalMedication();

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/emergencyContacts/{contactId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validEmergencyContact();

      allow update: if false;

      allow delete: if isOwner(userId);
    }
  }
}
