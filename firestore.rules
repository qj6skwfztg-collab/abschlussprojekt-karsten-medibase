rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser()
        && request.auth.uid == 'IjelVzBlIIgkJWgLiDdHrhLtwDf1';
    }

    function validTime(value) {
      return value is string
        && value.matches('^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validIntakeTimes() {
      return request.resource.data.intakeTimes is list
        && request.resource.data.intakeTimes.size() >= 1
        && request.resource.data.intakeTimes.size() <= 8
        && validTime(request.resource.data.intakeTimes[0])
        && (request.resource.data.intakeTimes.size() < 2
          || validTime(request.resource.data.intakeTimes[1]))
        && (request.resource.data.intakeTimes.size() < 3
          || validTime(request.resource.data.intakeTimes[2]))
        && (request.resource.data.intakeTimes.size() < 4
          || validTime(request.resource.data.intakeTimes[3]))
        && (request.resource.data.intakeTimes.size() < 5
          || validTime(request.resource.data.intakeTimes[4]))
        && (request.resource.data.intakeTimes.size() < 6
          || validTime(request.resource.data.intakeTimes[5]))
        && (request.resource.data.intakeTimes.size() < 7
          || validTime(request.resource.data.intakeTimes[6]))
        && (request.resource.data.intakeTimes.size() < 8
          || validTime(request.resource.data.intakeTimes[7]))
        && request.resource.data.intakeTimes.toSet().size()
          == request.resource.data.intakeTimes.size();
    }

    function validPersonalMedication() {
      return request.resource.data.keys().hasAll([
          'name',
          'dosage',
          'intakeTime',
          'intakeTimes',
          'notes',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'dosage',
          'intakeTime',
          'intakeTimes',
          'notes',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.dosage is string
        && request.resource.data.dosage.size() >= 1
        && request.resource.data.dosage.size() <= 100
        && validTime(request.resource.data.intakeTime)
        && validIntakeTimes()
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.createdAt is timestamp;
    }

    function validEmergencyContact() {
      return request.resource.data.keys().hasAll([
          'name',
          'phone',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt is timestamp;
    }

    function validEmergencyProfile() {
      return request.resource.data.keys().hasAll([
          'allergies',
          'conditions',
          'bloodGroup',
          'specialNotes',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'allergies',
          'conditions',
          'bloodGroup',
          'specialNotes',
          'updatedAt'
        ])
        && request.resource.data.allergies is string
        && request.resource.data.allergies.size() <= 300
        && request.resource.data.conditions is string
        && request.resource.data.conditions.size() <= 300
        && request.resource.data.bloodGroup is string
        && request.resource.data.bloodGroup.size() <= 30
        && request.resource.data.specialNotes is string
        && request.resource.data.specialNotes.size() <= 500
        && request.resource.data.updatedAt is timestamp;
    }

    function validHealthEntry() {
      return request.resource.data.keys().hasAll([
          'type',
          'value',
          'secondaryValue',
          'unit',
          'context',
          'notes',
          'measuredAt',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'type',
          'value',
          'secondaryValue',
          'unit',
          'context',
          'notes',
          'measuredAt',
          'createdAt'
        ])
        && request.resource.data.type is string
        && request.resource.data.type in [
          'bloodPressure',
          'bloodSugar',
          'pulse',
          'weight',
          'oxygen',
          'temperature',
          'symptom'
        ]
        && request.resource.data.value is number
        && request.resource.data.value >= 0
        && request.resource.data.secondaryValue is number
        && request.resource.data.secondaryValue >= 0
        && request.resource.data.unit is string
        && request.resource.data.unit.size() >= 1
        && request.resource.data.unit.size() <= 20
        && request.resource.data.context is string
        && request.resource.data.context.size() <= 100
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.measuredAt is timestamp
        && request.resource.data.createdAt is timestamp
        && (request.resource.data.type != 'bloodPressure'
          || (request.resource.data.value >= 50
            && request.resource.data.value <= 300
            && request.resource.data.secondaryValue >= 30
            && request.resource.data.secondaryValue <= 200
            && request.resource.data.secondaryValue < request.resource.data.value))
        && (request.resource.data.type != 'bloodSugar'
          || request.resource.data.value <= 1000)
        && (request.resource.data.type != 'pulse'
          || (request.resource.data.value >= 20
            && request.resource.data.value <= 250))
        && (request.resource.data.type != 'weight'
          || (request.resource.data.value > 0
            && request.resource.data.value <= 500))
        && (request.resource.data.type != 'oxygen'
          || (request.resource.data.value >= 50
            && request.resource.data.value <= 100))
        && (request.resource.data.type != 'temperature'
          || (request.resource.data.value >= 25
            && request.resource.data.value <= 45))
        && (request.resource.data.type != 'symptom'
          || request.resource.data.value <= 10);
    }

    match /medications/{medicationId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name',
          'category',
          'description',
          'source',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 1000
        && request.resource.data.source is string
        && request.resource.data.source.size() >= 5
        && request.resource.data.source.size() <= 500;

      allow update, delete: if false;
    }

    match /users/{userId}/medications/{personalMedicationId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && validPersonalMedication();

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/emergencyContacts/{contactId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validEmergencyContact();

      allow update: if false;

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/emergencyProfile/{profileId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && profileId == 'main'
        && validEmergencyProfile();

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/healthEntries/{entryId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && validHealthEntry();

      allow delete: if isOwner(userId);
    }
  }
}
